Deployment_Node(backend_node, "Сервер приложений", "Linux / Docker") {
 Container(route_service, "Сервис маршрутов и каталога", "FastAPI :8443", "Смежный контейнер")
 Container(recommendation_service, "Сервис рекомендаций", "FastAPI :8001 / TLS", "Один процесс; реестр и RAM-кэш внутри")
}
