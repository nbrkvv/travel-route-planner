@startuml
!pragma layout smetana
!define RELATIVE_INCLUDE
!include ../../../../vendor/C4_Component.puml
LAYOUT_TOP_DOWN()
title Динамика ML — ранжирование кандидатов
Container(route_service, "Сервис маршрутов и каталога", "Python / FastAPI", "Кандидаты и контекст поездки")
Container_Boundary(recommendation_service, "Сервис рекомендаций — один процесс Python") {
 Component(rec_api_comp, "API-контроллеры рекомендаций", "FastAPI / Pydantic", "Проверка DTO и координация")
 Component(rec_inference_comp, "Движок ML-инференса", "Python / scikit-learn", "Признаки и оценки кандидатов")
 Component(rec_explainer_comp, "Модуль объяснений", "Python", "Причины рекомендаций")
 Component(rec_model_registry_comp, "Реестр и загрузчик моделей", "Python / boto3", "Активная модель и метаданные в RAM")
}

Rel(route_service, rec_api_comp, "1. POST /v1/recommendations: кандидаты и интересы", "HTTPS / JSON, 8001")
Rel(rec_api_comp, rec_inference_comp, "2. Запускает скоринг", "Python Call")
Rel(rec_inference_comp, rec_model_registry_comp, "3. Получает активную модель и версию из RAM", "Python Call")
Rel(rec_api_comp, rec_explainer_comp, "4. Передаёт результаты для объяснений", "Python Call")
Rel(rec_explainer_comp, rec_model_registry_comp, "5. Получает метаданные использованной версии", "Python Call")

SHOW_LEGEND()
@enduml
