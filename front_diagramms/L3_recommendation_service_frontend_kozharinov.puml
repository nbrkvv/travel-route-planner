@startuml
!pragma layout smetana
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title L3 Декомпозиция контейнера "Сервис рекомендаций"

Container(api, "Сервис маршрутов и каталога", "Python, FastAPI", "Отправляет кандидатов и контекст")
ContainerDb(models, "Хранилище моделей", "MinIO, S3 API", "Версии моделей и препроцессоры")

Container_Boundary(recommend, "Сервис рекомендаций — один процесс Python / FastAPI") {
    Component(rec_api_comp, "API-контроллеры рекомендаций", "FastAPI Router, Pydantic", "Прием HTTP-запросов, валидация DTO кандидатов и контекста")
    Component(rec_inference_comp, "Движок ML-инференса", "Python, scikit-learn, numpy", "Скоринг кандидатов и ранжирование с помощью активной модели")
    Component(rec_explainer_comp, "Модуль объяснений", "Python", "Генерация текстовых причин рекомендации на основе доступных признаков")
    Component(rec_model_registry_comp, "Реестр и загрузчик моделей", "Python, boto3", "Загрузка артефактов из MinIO, кэширование в памяти, управление версиями")
}
Rel(api, rec_api_comp, "Кандидаты, интересы и контекст", "HTTPS / REST / JSON")
Rel(rec_api_comp, api, "Оценки мест и причины", "HTTPS / REST / JSON")
Rel(rec_model_registry_comp, models, "Загрузка модели и признаков", "HTTPS / S3 API")
Rel(rec_api_comp, rec_inference_comp, "I1 Запуск скоринга кандидатов", "Python Call")
Rel(rec_api_comp, rec_explainer_comp, "I2 Запрос объяснений для top-N", "Python Call")
Rel(rec_inference_comp, rec_model_registry_comp, "I3 Получение активной модели", "Python Call")
Rel(rec_explainer_comp, rec_model_registry_comp, "I4 Получение метаданных модели", "Python Call")
SHOW_LEGEND()
@enduml
