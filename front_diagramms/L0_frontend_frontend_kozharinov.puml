@startuml
' ЛР №4, часть 1: диаграмма системного ландшафта (Level 0), фронтенд-представление.
!define RELATIVE_INCLUDE
!include ../vendor/C4-PlantUML/C4_Context.puml

LAYOUT_TOP_DOWN()

title L0 Системный ландшафт — фронтенд-представление (веб- и мобильное приложение)

Person(traveler, "Путешественник", "Планирует поездку, смотрит маршрут на карте, оценивает места")
Person(guest, "Гость без регистрации", "Изучает публичный каталог и примеры маршрутов")
Person(catalog_editor, "Редактор каталога", "Заполняет и публикует карточки мест")

Enterprise_Boundary(tourism_it, "ИТ-инфраструктура туристической платформы") {
  System(travel_system, "Система построения маршрутов путешествия", "Строит персональный маршрут; клиентская часть — веб- и мобильное приложение")
  System_Ext(idp, "Провайдер идентификации (IAM)", "Единый вход, токены и публичные ключи проверки")
  System_Ext(tourism_crm, "CRM туристической платформы", "Профили туристов, обращения в поддержку, льготные категории")
}

System_Ext(payment_gateway, "Платёжный шлюз (эквайринг)", "Внешняя финансовая система: оплата платных билетов и экскурсий")
System_Ext(maps_service, "Картографический сервис", "Тайлы подложки карты, геокодирование")
System_Ext(device_location, "Служба геолокации устройства", "Браузер и ОС выдают координаты после разрешения пользователя")

Rel(traveler, travel_system, "Задаёт интересы, бюджет и время; получает маршрут и статусы", "HTTPS / JSON")
Rel(guest, travel_system, "Просматривает публичный каталог и примеры маршрутов без входа", "HTTPS / JSON")
Rel(catalog_editor, travel_system, "Редактирует карточки мест; получает результат публикации", "HTTPS / JSON")
Rel(travel_system, idp, "Перенаправляет на вход; получает код авторизации и токены", "HTTPS / OIDC / OAuth 2.0")
Rel(travel_system, tourism_crm, "Передаёт обращения и согласия; получает льготные категории", "gRPC")
Rel(travel_system, payment_gateway, "Создаёт платёж за билет; получает статус оплаты", "HTTPS / REST / JSON")
Rel(travel_system, maps_service, "Запрашивает тайлы для отображения карты", "HTTPS / Tiles")
Rel(travel_system, device_location, "Запрашивает стартовые координаты с разрешения пользователя", "API браузера / ОС")

SHOW_LEGEND()
@enduml
